# ========== 通用 ==========
TZ=Asia/Shanghai
MP_APP_VERSION=0.4.1
MP_LOG_LEVEL=INFO
MP_API_PORT=8000
# 前端宿主端口；8080 被占用时改成 8081/18080 等
WEB_PORT=8080

# ========== 数据库 ==========
# 本地开发默认 SQLite；docker compose 会用下方的 PostgreSQL 变量自动覆盖 MP_DATABASE_URL
MP_DATABASE_URL=sqlite:///./data/motor.db
# 生产/容器：postgresql+psycopg://motor:change-me@db:5432/motor_monitor
POSTGRES_DB=motor_monitor
POSTGRES_USER=motor
POSTGRES_PASSWORD=change-me

# ========== 采集 ==========
MP_POLL_INTERVAL_MINUTES=15
MP_POLL_ON_START=true
MP_RUN_COLLECTOR=true
# modbus: 真实网关；simulator: 模拟数据（仅演示/验收）
MP_COLLECTOR_MODE=modbus
MP_MODBUS_TIMEOUT_SECONDS=3
MP_MODBUS_RETRIES=2
MP_RETENTION_DAYS=180
MP_BASELINE_DAYS=30
MP_ALARM_SUPPRESSION_MINUTES=30

# ========== 认证 ==========
# off: 内网试点直连（默认）；proxy: 由 SSO/oauth2-proxy 网关注入用户头
MP_AUTH_MODE=off
MP_AUTH_PROXY_HEADER=X-Auth-User
MP_DEFAULT_USER=设备科 · 观察员

# ========== 飞书 ==========
# 飞书应用 App ID / App Secret / Chat ID 在前端“通知机器人”页绑定，保存在本地数据库，不需要写入 .env
# 以下 Webhook 仅作为应用发送失败时的兼容回退
MP_FEISHU_ENABLED=false
MP_FEISHU_WEBHOOK_URL=
MP_FEISHU_WEBHOOK_SECRET=

# ========== 试点信息 / LoRa 参数 ==========
MP_PILOT_START_DATE=2026-10-26
MP_PILOT_DAYS=30
MP_LORA_FREQUENCY_MHZ=470
MP_LORA_BAUD_RATE=1200
MP_LORA_SF=7
MP_LORA_BW_KHZ=125
MP_LORA_CR=4/5

# ========== 容器构建镜像源（网络受限时按需修改） ==========
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# ========== 前端（构建参数） ==========
VITE_API_BASE=/api/v1
